{
    "env": {
        "browser": true,
        "node": true,
        "es2021": true
    },
    "root": true,
    "extends": "eslint:recommended",
    "rules": {
        "no-undef": "error",
        "eqeqeq": "error",
        "prefer-const": "error",
        "arrow-body-style": [
            "error",
            "as-needed"
        ],
        "no-var": "error",
        "indent": [
            "error",
            2
        ],
        "semi": [
            "error",
            "always"
        ],
        "no-eval": "error",
        "no-implied-eval": "error"
    },
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    }
}