{
  "name": "bloqbit",
  "displayName": "Bloqbit",
  "description": "The all-in-one solution for your Discord server.",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "author": {
    "name": "Bloqbit Developers",
    "url": "https://bloqbit.cubicstudios.xyz/",
    "email": "bloqbit@cubicstudios.xyz"
  },
  "api": "none",
  "private": true,
  "workspaces": [
    "modules/*"
  ],
  "badges": [
    {
      "name": "Website",
      "description": "Visit the official Bloqbit website",
      "href": "https://bloqbit.cubicstudios.xyz/",
      "url": "https://bloqbit.cubicstudios.xyz/"
    },
    {
      "name": "GitHub",
      "description": "View the source code on GitHub",
      "href": "https://www.github.com/CubicCommunity/Bloqbit/",
      "url": "https://bloqbit.cubicstudios.xyz/"
    }
  ],
  "imports": {
    "#bloqbit/*": [
      "./include/*",
      "./include/**/*"
    ],
    "#assets": [
      "./assets.json"
    ]
  },
  "dependencies": {
    "@discordjs/builders": "^1.11.3",
    "discord-api-types": "^0.38.25",
    "discord.js": "^14.22.1",
    "fs": "^0.0.1-security",
    "mariadb": "^3.4.5",
    "node-cache": "^5.1.2",
    "path": "^0.12.7",
    "tsconfig-paths": "^4.2.0"
  },
  "main": "main.ts",
  "engines": {
    "node": ">=21.0.0"
  },
  "eslintConfig": {
    "extends": [
      "@eslint/js",
      "plugin:node/recommended"
    ],
    "env": {
      "es2021": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/mysql": "^2.15.27",
    "@types/node": "^24.4.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "lint": "eslint .",
    "build:ts": "tsc",
    "build:rust": "for dir in modules/*; do [ -f \"$dir/Cargo.toml\" ] && (cd \"$dir\" && npx napi build --release); done",
    "build": "npm run build:rust && npm run build:ts",
    "test": "echo No test file configured",
    "start": "node --loader ts-node/esm --expose-gc main.ts",
    "dev": "ts-node --esm main.ts",
    "clean": "rimraf dist && rimraf --glob 'modules/**/*.node'",
    "build:prepare": "npm run clean && npm run build",
    "pkg:prepare": "npm run build:rust && npx tsc main.ts --outDir dist --esModuleInterop --module commonjs",
    "pkg:build": "pkg dist/main.js"
  },
  "bin": "main.js",
  "pkg": {
    "scripts": "main.js",
    "assets": [
      "modules/cache/index.node"
    ],
    "targets": [
      "node20-win-x64",
      "node20-linux-x64",
      "node20-macos-x64"
    ],
    "outputPath": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/CubicCommunity/Bloqbit/"
  },
  "funding": {
    "type": "github",
    "url": "https://www.github.com/sponsors/CubicCommunity/"
  },
  "keywords": [
    "bloqbit",
    "utility",
    "moderation",
    "fun",
    "discord",
    "bot"
  ],
  "icon": "./favicon.ico",
  "bugs": {
    "email": "bloqbit@cubicstudios.xyz",
    "url": "https://www.github.com/CubicCommunity/Bloqbit/issues/"
  },
  "contributors": [
    "Cheeseworks"
  ],
  "homepage": "https://bloqbit.cubicstudios.xyz/"
}