{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "allowJs": true,
        "checkJs": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "*": [
                "src/*"
            ]
        },
        "lib": [
            "ESNext",
        ],
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
    },
    "include": [
        "src/**/*.js",
        "src/**/*.mjs",
        "src/**/*.json",
        "src/**/*.ts",
    ],
    "exclude": [
        "node_modules",
        "reserves"
    ],
}