{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 12,
        "sourceType": "module"
    },
    "rules": {
        "strict": [
            "error",
            "global"
        ],
        "no-undef": "error",
        "no-unused-vars": "warn",
        "no-console": "off"
    }
}